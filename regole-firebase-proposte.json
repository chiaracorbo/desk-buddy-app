                },
                "giorni": {
                  ".validate": "newData.hasChildren(['0', '1', '2', '3', '4', '5', '6'])",
                  "$giorno": {
                    ".validate": "$giorno.matches(/^[0-6]$/) && newData.isBoolean()"
                  }
                },
                "testo": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$altro": {
                  ".validate": false
                }
              }
            },
            "$altro": {
              ".validate": false
            }
          },
          "stato": {
            ".validate": "newData.hasChildren(['versione', 'ultimoContatto'])",
            "stile": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
            },
