            },
            "citta": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "funzioni": {
              "$funzione": {
                ".validate": "$funzione.matches(/^(pomodoro|promemoria|meteo|radar|contoAllaRovescia|respiro|tiPenso|giochi|foto|oraDoro|sfida|diario|delusa)$/) && newData.isBoolean()"
              }
            },
