            },
            "ultimaMossa": {
              ".validate": "newData.hasChildren(['chi', 'posizione'])",
              "chi": {
                ".validate": "newData.isString() && newData.val().matches(/^(giocatore|buddy)$/)"
              },
              "posizione": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 == 0"
              },
              "da": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 63 && newData.val() % 1 == 0"
              },
              "prese": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12 && newData.val() % 1 == 0"
              },
              "risultato": {
