                ".validate": "newData.isBoolean()"
              },
              "ora": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23 && newData.val() % 1 == 0"
              },
              "minuto": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 59 && newData.val() % 1 == 0"
              },
              "giorni": {
                ".validate": "newData.hasChildren(['0', '1', '2', '3', '4', '5', '6'])",
                "$giorno": {
                  ".validate": "$giorno.matches(/^[0-6]$/) && newData.isBoolean()"
                }
              },
              "$altro": {
                ".validate": false
              }
            },
            "promemoriaMinuti": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 240 && newData.val() % 1 == 0"
            },
            "citta": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "funzioni": {
              "$funzione": {
                ".validate": "$funzione.matches(/^(pomodoro|promemoria|meteo|radar|contoAllaRovescia|respiro|tiPenso|giochi|foto|oraDoro|sfida|diario|delusa)$/) && newData.isBoolean()"
              }
            },
            "versione": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lon": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "luogo": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
